{
  "name": "hushmark",
  "displayName": "Hushmark",
  "description": "%description%",
  "version": "0.3.1",
  "publisher": "vanpeiyu",
  "private": true,
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#41664B",
    "theme": "dark"
  },
  "homepage": "https://github.com/vanpeiyu/hushmark#readme",
  "bugs": {
    "url": "https://github.com/vanpeiyu/hushmark/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vanpeiyu/hushmark.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "live preview",
    "wysiwyg",
    "editor",
    "inline preview",
    "typora",
    "obsidian",
    "cjk",
    "japanese",
    "table editor"
  ],
  "main": "./src/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "browser": "./dist/web/extension.js",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "npm run build && node test/e2e/index.mjs",
    "test:e2e:docker": "docker build -q -t hushmark-e2e -f test/e2e/Dockerfile . && docker run --rm --init --shm-size=1g hushmark-e2e",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies",
    "test:web": "npm run build && node test/web/smoke.mjs",
    "demo": "docker build -q -t hushmark-e2e -f test/e2e/Dockerfile . && mkdir -p docs/images && docker run --rm --init --shm-size=1g -v \"$PWD/docs/images:/out\" --entrypoint xvfb-run hushmark-e2e -a -s \"-screen 0 1600x1000x24\" sh -c \"npm run build && node test/demo/record.mjs --out /out/demo.gif && node test/demo/record.mjs --lang ja --out /out/demo-ja.gif\""
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "hushmark.editor",
        "displayName": "Hushmark",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "hushmark.open",
        "title": "%command.open%",
        "category": "Hushmark",
        "icon": "$(preview)"
      },
      {
        "command": "hushmark.openSource",
