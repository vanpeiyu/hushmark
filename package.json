      },
      {
        "command": "hushmark.moveLinesDown",
        "title": "%command.moveLinesDown%",
        "category": "Hushmark"
      },
      {
        "command": "hushmark.copyLinesUp",
        "title": "%command.copyLinesUp%",
        "category": "Hushmark"
      },
      {
        "command": "hushmark.copyLinesDown",
        "title": "%command.copyLinesDown%",
        "category": "Hushmark"
      },
      {
        "command": "hushmark.deleteLines",
        "title": "%command.deleteLines%",
        "category": "Hushmark"
      },
      {
        "command": "hushmark.insertLineAfter",
        "title": "%command.insertLineAfter%",
