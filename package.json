    "configuration": {
      "title": "Hushmark",
      "properties": {
        "hushmark.previewStyle": {
          "type": "string",
          "enum": [
            "soft",
            "minimal",
            "reference"
          ],
          "enumItemLabels": [
            "%config.previewStyle.soft%",
            "%config.previewStyle.minimal%",
            "%config.previewStyle.reference%"
          ],
          "default": "soft",
          "order": 1,
          "description": "%config.previewStyle%"
        },
        "hushmark.previewColor": {
          "type": "string",
          "enum": [
            "green",
            "cyan",
            "blue",
            "purple",
            "pink",
            "orange",
            "sepia",
            "mono",
            "custom"
          ],
          "enumItemLabels": [
            "%config.previewColor.green%",
            "%config.previewColor.cyan%",
            "%config.previewColor.blue%",
            "%config.previewColor.purple%",
            "%config.previewColor.pink%",
            "%config.previewColor.orange%",
            "%config.previewColor.sepia%",
            "%config.previewColor.mono%",
            "%config.previewColor.custom%"
          ],
          "default": "green",
          "order": 2,
          "description": "%config.previewColor%"
        },
        "hushmark.previewColorScheme": {
          "type": "string",
          "enum": [
            "theme",
            "auto",
            "light",
            "dark"
          ],
          "enumItemLabels": [
            "%config.previewColorScheme.theme%",
            "%config.previewColorScheme.auto%",
            "%config.previewColorScheme.light%",
            "%config.previewColorScheme.dark%"
          ],
          "default": "theme",
          "order": 3,
          "description": "%config.previewColorScheme%",
          "enumDescriptions": [
            "%config.previewColorScheme.theme.description%",
            "%config.previewColorScheme.auto.description%",
            "%config.previewColorScheme.light.description%",
            "%config.previewColorScheme.dark.description%"
          ]
        },
        "hushmark.previewCustomColor": {
          "type": "string",
          "format": "color-hex",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "patternErrorMessage": "%config.previewCustomColor.pattern%",
          "default": "#3366cc",
          "order": 4,
          "description": "%config.previewCustomColor%"
        },
        "hushmark.colorCustomizations": {
          "type": "object",
          "default": {},
          "order": 5,
          "properties": {
            "background": {
              "type": "string",
              "format": "color"
            },
            "foreground": {
              "type": "string",
              "format": "color"
            },
            "strongForeground": {
              "type": "string",
              "format": "color"
            },
            "mutedForeground": {
              "type": "string",
              "format": "color"
            },
            "border": {
              "type": "string",
              "format": "color"
            },
            "strongBorder": {
              "type": "string",
              "format": "color"
            },
            "blockBackground": {
              "type": "string",
              "format": "color"
            },
            "codeBackground": {
              "type": "string",
              "format": "color"
            },
            "accent": {
              "type": "string",
              "format": "color"
            },
            "softAccent": {
              "type": "string",
              "format": "color"
            },
            "accentBackground": {
              "type": "string",
              "format": "color"
            },
            "link": {
              "type": "string",
              "format": "color"
            },
            "highlight": {
              "type": "string",
              "format": "color"
            },
            "selection": {
              "type": "string",
              "format": "color"
            },
            "lineHighlight": {
              "type": "string",
              "format": "color"
            }
          },
          "patternProperties": {
            "^\\[(green|cyan|blue|purple|pink|orange|sepia|mono|custom)\\]$": {
              "type": "object",
              "properties": {
                "background": {
                  "type": "string",
                  "format": "color"
                },
                "foreground": {
                  "type": "string",
                  "format": "color"
                },
                "strongForeground": {
                  "type": "string",
                  "format": "color"
                },
                "mutedForeground": {
                  "type": "string",
                  "format": "color"
                },
                "border": {
                  "type": "string",
                  "format": "color"
                },
                "strongBorder": {
                  "type": "string",
                  "format": "color"
                },
                "blockBackground": {
                  "type": "string",
                  "format": "color"
                },
                "codeBackground": {
                  "type": "string",
                  "format": "color"
                },
                "accent": {
                  "type": "string",
                  "format": "color"
                },
                "softAccent": {
                  "type": "string",
                  "format": "color"
                },
                "accentBackground": {
                  "type": "string",
                  "format": "color"
                },
                "link": {
                  "type": "string",
                  "format": "color"
                },
                "highlight": {
                  "type": "string",
                  "format": "color"
                },
                "selection": {
                  "type": "string",
                  "format": "color"
                },
                "lineHighlight": {
                  "type": "string",
                  "format": "color"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "markdownDescription": "%config.colorCustomizations%"
        },
        "hushmark.headingSize": {
          "type": "string",
          "enum": [
            "body",
            "medium",
            "large"
          ],
          "enumItemLabels": [
            "%config.headingSize.body%",
            "%config.headingSize.medium%",
            "%config.headingSize.large%"
          ],
          "default": "medium",
          "order": 6,
          "description": "%config.headingSize%"
        },
        "hushmark.rightMargin": {
          "type": "boolean",
          "default": true,
          "order": 7,
          "description": "%config.rightMargin%"
        },
        "hushmark.debugLog": {
          "type": "boolean",
          "default": false,
          "order": 8,
          "description": "%config.debugLog%"
        }
      }
    },
    "keybindings": [
      {
        "command": "hushmark.goToHeading",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeCustomEditorId == hushmark.editor"
      },
      {
        "command": "hushmark.bold",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "hushmark.editorFocus"
      },
      {
        "command": "hushmark.italic",
        "key": "ctrl+i",
