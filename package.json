        "when": "hushmark.editorFocus"
      },
      {
        "command": "hushmark.findInFiles",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "hushmark.editorFocus"
      },
      {
        "command": "hushmark.replaceInFiles",
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+h",
        "when": "hushmark.editorFocus"
      },
      {
        "command": "hushmark.moveLinesUp",
        "key": "alt+up",
        "mac": "alt+up",
        "when": "hushmark.editorFocus"
      },
      {
        "command": "hushmark.moveLinesDown",
